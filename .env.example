# Backend
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# GitHub (optional)
GITHUB_TOKEN="ghp_xxx"

# If you use GitHub Token DB storage, set a 32-byte base64 key.
GITHUB_TOKEN_ENCRYPTION_KEY="base64_32_bytes"

# Next integration (Nest serves Next from ./web)
NEXT_ENABLED=1

# Only needed when running the Next app separately (web/).
NEST_BACKEND_URL="http://localhost:3000"

# Frontend (optional)
NEXT_PUBLIC_API_BASE_URL="/api"

